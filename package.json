{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "react-snap",
    "lint": "oxlint",
    "preview": "vite preview",
    "sitemap": "node scripts/generate-sitemap.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "dotenv": "^17.4.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "react-snap": "^1.23.0",
    "sitemap": "^9.0.1",
    "vite": "^8.2.2"
  },
  "reactSnap": {
    "source": "dist",
    "destination": "dist",
    "include": [
      "/",
      "/about",
      "/services",
      "/process",
      "/process/recruitment",
      "/process/work-visa",
      "/process/quality-policy",
      "/legal-status",
      "/legal-status/govt-license",
      "/legal-status/iso-certification",
      "/contact",
      "/submit-cv",
      "/careers",
      "/faq",
      "/our-team",
      "/privacy-policy",
      "/terms-conditions"
    ],
    "minifyHtml": {
      "collapseWhitespace": true,
      "removeComments": true
    },
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ],
    "skipThirdPartyRequests": false,
    "concurrency": 2,
    "timeout": 60000
  }
}